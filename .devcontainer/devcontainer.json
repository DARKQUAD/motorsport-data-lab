{
  "name": "Motorsport Data Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e \".[app,models]\" pytest",
  "postAttachCommand": {
    "app": "python -m streamlit run streamlit_app.py --server.headless true --server.port 8501"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit app", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] }
  }
}
